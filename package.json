    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.13",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
