    "prebuild": "bun scripts/copy-sqlite-wasm.ts",
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "serve out",
    "analyze": "next analyze",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test src scripts",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "icons": "bun scripts/generate-icons.ts"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@lezer/highlight": "^1.2.5",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "comlink": "^4.4.2",
