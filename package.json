    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.9",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
